# SeatSafe app environment. Copy to .env.local (never commit .env.local).
# The app runs with NONE of these set: mocks on, login disabled, Supabase client null.

# Mock data switch for lib/hooks.ts. Anything other than "false" means mock mode.
NEXT_PUBLIC_USE_MOCK=true

# Privy app ID (dashboard.privy.io). Enable email + Google login and Solana embedded wallets.
NEXT_PUBLIC_PRIVY_APP_ID=cmwjugv1q00bo0gjvq0qw9emn

# Solana devnet RPC (a QuickNode devnet URL works here too).
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Circle's devnet USDC mint. If balances look wrong, verify it at https://developers.circle.com
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# SeatSafe Anchor program ID on devnet.
# Program ID: 7fnVUPd18tDr2CbEgjTxt55Emq4CMMskR9qxprjQjypy
#   (deployed to devnet Nov 16, 2026; upgrade authority = deployer)
NEXT_PUBLIC_PROGRAM_ID=7fnVUPd18tDr2CbEgjTxt55Emq4CMMskR9qxprjQjypy

# Supabase (B shares these). The anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never import in client components.
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs voice agent for the agent's incoming-call approval (components/VoiceApproval.tsx).
# Public agent (no auth), so the ID is safe in the browser. Ask D for it.
# Empty = no voice; the Approve / Decline buttons still work.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Gas sponsorship (app/app/api/relay). The relayer pays every fee and rent so users never need SOL.
# Public key of the relayer (safe in the browser). The client also asks GET /api/relay, which wins
# if the two ever differ. Devnet relayer: 7r2SszeUx3xyJsjAeUYvveMMmvkjjvxbPhxUGiP78g61
NEXT_PUBLIC_RELAYER_PUBKEY=7r2SszeUx3xyJsjAeUYvveMMmvkjjvxbPhxUGiP78g61
# SERVER ONLY. The relayer's secret key: the JSON byte array from .keys/relayer.json ("[12,34,...]")
# or a base58 string. Never NEXT_PUBLIC_. If empty, the relayer is off and users pay their own fees
# (their Privy wallet then needs devnet SOL). Keep the relayer funded with devnet SOL.
RELAYER_SECRET_KEY=

# --- Member B: database, stream, cron, chat, standing orders. See docs/backend.md. ---

# Where Discover reads events when mocks are off.
# chain    = devnet events (use this for the live demo)
# supabase = rows from supabase/seed.sql
# auto     = chain when the RPC returns any events, otherwise Supabase (default)
NEXT_PUBLIC_EVENTS_SOURCE=auto

# QuickNode Stream destination secret. Send it as the x-webhook-secret header, or ?secret= on the URL.
# Required in production. Local dev accepts unsigned webhooks when this is empty.
STREAM_WEBHOOK_SECRET=

# Vercel Cron sends Authorization: Bearer $CRON_SECRET. Required in production.
CRON_SECRET=

# Standing orders at or above this price (USD) wait for a voice/button approval instead of filling.
STANDING_ORDER_APPROVAL_USD=75

# Rating used when a seller has no users.rating row. "none" skips them whenever min rating is above 0.
DEFAULT_SELLER_RATING=4.8

# When "true", POST /api/orders tells the client to use 60-second escrow windows.
DEMO_DEADLINES=true

# Optional. One of these powers parsing, the scam detector and dispute summaries.
# With neither set, the keyword parser and the scam rules still run.
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional. POST a Slack-style { "text" } payload when the relayer drops under 1 SOL.
ALERT_WEBHOOK_URL=
