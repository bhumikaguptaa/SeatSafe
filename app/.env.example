# SeatSafe app environment. Copy to .env.local (never commit .env.local).
# The app runs with NONE of these set: mocks on, login disabled, Supabase client null.

# Mock data switch for lib/hooks.ts. Anything other than "false" means mock mode.
NEXT_PUBLIC_USE_MOCK=true

# Privy app ID (dashboard.privy.io). Enable email + Google login and Solana embedded wallets.
NEXT_PUBLIC_PRIVY_APP_ID=cmwjugv1q00bo0gjvq0qw9emn

# Solana devnet RPC (a QuickNode devnet URL works here too).
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Circle's devnet USDC mint. If balances look wrong, verify it at https://developers.circle.com
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# SeatSafe Anchor program ID on devnet.
# Program ID: 7fnVUPd18tDr2CbEgjTxt55Emq4CMMskR9qxprjQjypy
#   (deployed to devnet Nov 16, 2026; upgrade authority = deployer)
NEXT_PUBLIC_PROGRAM_ID=7fnVUPd18tDr2CbEgjTxt55Emq4CMMskR9qxprjQjypy

# Supabase (B shares these). The anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never import in client components.
SUPABASE_SERVICE_ROLE_KEY=
# Relayer keypair that pays gas, as a JSON byte array or base58 secret. Server only.
RELAYER_SECRET_KEY=
